{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/split.py": {
      "maxDuration": 60,
      "runtime": "python3.9"
    }
  },
  "rewrites": [
    { "source": "/api/split", "destination": "/api/split.py" },
    { "source": "/toc-generator", "destination": "/toc_generator.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}